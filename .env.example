# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Vite only exposes variables prefixed with VITE_ to the browser, so never put
# a secret (private key, API secret) in here — everything below ships to the client.

# ─── API ──────────────────────────────────────────────────────────────────────
# Leave unset in development to use the Vite proxy in vite.config.js (/api -> dev.veyu.autos).
# VITE_API_BASE_URL=https://dev.veyu.autos/api/v1

# ─── Firebase (Google sign-in only) ───────────────────────────────────────────
# From Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Without these, the app still runs and email/password auth works — the
# "Continue with Google" button is disabled on /login and /signup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Paystack publishable key (pk_test_... or pk_live_...).
VITE_PAYSTACK_LIVE_PUBLIC_KEY=

# ─── Realtime chat ────────────────────────────────────────────────────────────
# VITE_WS_URL=wss://server.motaa.net

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Set to true to enable verbose logging in wallet/chat screens.
VITE_DEBUG=false
